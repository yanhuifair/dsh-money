{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "lib",
    "rootDir": "src",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "useDefineForClassFields": false,
    "composite": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": []
  },
  "include": [
    "src/index.ts",
    "src/client.ts",
    "src/types.ts"
  ]
}