{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "composite": true,
    "outDir": "build",
    "rootDir": "src",
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "ESNext.Disposable"],
    "types": []
  },
  "include": ["src/**/*.ts"]
}
