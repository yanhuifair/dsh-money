{
  "name": "dsh-money-monorepo",
  "private": true,
  "version": "1.10.2",
  "description": "DeepSeek Harness 费用追踪插件（monorepo 根）",
  "license": "AGPL-3.0",
  "type": "module",
  "workspaces": [
    "packages/dsh-money"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/tip-test.cjs && node test/host-test.mjs",
    "publish:pkg": "npm publish -w dsh-money --access public",
    "publish:dry": "npm publish -w dsh-money --access public --dry-run",
    "prepublishOnly": "echo '❌ 仓库根目录（dsh-money-monorepo）不发布。private:true 是保护，不是错误。' && echo '   发布插件包请执行： npm run publish:pkg' && echo '   （等价命令： npm publish -w dsh-money --access public）' && exit 1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-loader": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "zod": "4.6.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=18"
  }
}
