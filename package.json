{
  "name": "dsh-money",
  "version": "1.0.2",
  "description": "DeepSeek Harness 费用追踪插件：显示账号余额、当前对话费用与每次回复费用，金色标签风格，支持币种切换",
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "src/host.js",
  "types": "src/types.d.ts",
  "exports": {
    ".": {
      "types": "./src/types.d.ts",
      "default": "./src/host.js"
    },
    "./host": "./src/host.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "cordis",
    "cost",
    "billing",
    "token",
    "费用",
    "余额"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanhuifair/dsh-money.git"
  },
  "bugs": {
    "url": "https://github.com/yanhuifair/dsh-money/issues"
  },
  "homepage": "https://github.com/yanhuifair/dsh-money#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-typert-loader": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
